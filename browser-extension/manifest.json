{
  "manifest_version": 3,
  "name": "MAIL HUB 助手",
  "version": "1.0.0",
  "description": "一键申领邮箱、自动提取验证码、完成注册后释放邮箱",
  "permissions": ["storage", "clipboardWrite", "notifications"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
